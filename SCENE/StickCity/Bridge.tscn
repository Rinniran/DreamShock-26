[sub_resource type="GDScript" id="GDScript_bw714"]
resource_name = "SCSTART"
script/source = "@tool
extends BaseState

@onready var boss = preload(\"res://OBJECT/GENERAL/Enemy/Foresight/ForeSight.tscn\").instantiate()

var tw 
func _enter(data = {}):
	super._enter(data)
	tw = create_tween()


func _step():
	super._step()
	if Input.is_action_just_pressed(\"PAD1_START\") && parent.state_time > 5:
		$R01.stop()
		$R02.stop()
		$R03.stop()
		
		tw.stop()
		root.cam.offset.x = 0
		boss.detected = true
		boss.position = Vector2(3792.0, 60.0)
		get_parent().add_child(boss)
		Global.activegame = true
		root.player.state.change_state(\"Idle\")
		root.mon.queue_free()
		root.subs.visible = false
		root.active = false
	
	match (parent.state_time):
		5:
			Global.activegame = false
			Global.musicP.volume_db = -12
			root.player.state.change_state(\"CSIdle1\")
		30:
			tw = create_tween()
			tw.set_trans(Tween.TRANS_QUAD)
			tw.set_ease(Tween.EASE_IN_OUT)
			tw.tween_property(root.cam,\"offset:x\", 125, 1.0)
			root.subs.visible = true
			root.subs.text = \"Balls. The bridge is out. \\nI might have to just fly across.\"
			#$R01.play()
		320:
			var tw = create_tween()
			tw.set_trans(Tween.TRANS_QUAD)
			tw.set_ease(Tween.EASE_IN_OUT)
			tw.tween_property(root.mon,\"position:y\", 113, 1.0)
			root.subs.text = \"Ah Ah Aaahh. Hold it right there, will you?\"
		460:
			root.subs.text = \"And you are...?\"
			#$R02.play()
		540:
			root.subs.text = \"Oohh, just a scientist who could really use \\nsome bounty money for her funding, you see!\"
		800:
			root.subs.text = \"Hard pass. Anyways, the bridge...\"
			#$R03.play()
		1200:
			root.subs.text = \"Low IQ move on my part to even begin to \\nsuspect you'd make this easy for me.\"
			Global.bossactive = true
		1520:
			root.subs.text = \"You're coming with me whether you like it or not.\"
		1820:
			var tw = create_tween()
			tw.set_trans(Tween.TRANS_QUAD)
			tw.set_ease(Tween.EASE_IN_OUT)
			tw.tween_property(root.mon,\"position:y\", -113, 3.0)
			root.subs.visible = false
			parent.change_state(\"ScSpawnBoss\")
	



func _step_frozen():
	super._step_frozen()


func _exit(next_state):
	
	super._exit(next_state)
"

