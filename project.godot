; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="DreamShock"
run/main_scene="uid://0oqjlx6seerv"
config/features=PackedStringArray("4.6", "Mobile")
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/use_filter=false
boot_splash/image="uid://h2g7jw6aslrs"
config/icon="uid://dsvfpblypg2af"
config/windows_native_icon="res://icon.ico"

[autoload]

GeneralFunctions="*res://SRC/GeneralFunctions.gd"
Remap="*res://addons/easy_remap/autoload.gd"
Global="*res://SRC/Global.gd"

[display]

window/size/viewport_width=320
window/size/viewport_height=224
window/size/window_width_override=960
window/size/window_height_override=672
window/stretch/mode="viewport"
window/vsync/vsync_mode=0

[editor]

movie_writer/disable_vsync=true

[editor_plugins]

enabled=PackedStringArray("res://addons/PaletteSwapShader/plugin.cfg", "res://addons/aseprite_importer/plugin.cfg", "res://addons/easy_remap/plugin.cfg", "res://addons/godot_doctor/plugin.cfg")

[global_group]

Player=""

