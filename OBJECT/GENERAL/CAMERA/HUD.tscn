[sub_resource type="GDScript" id="GDScript_ukscj"]
resource_name = "Selector"
script/source = "extends Sprite2D

@onready var img1 = preload(\"res://SPRITE/UI/SubIcon1.png\")
@onready var img2 = preload(\"res://SPRITE/UI/SubIcon2.png\")
@onready var img3 = preload(\"res://SPRITE/UI/SubIcon3.png\")
# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	pass # Replace with function body.


# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(delta: float) -> void:
	match (Global.currweapon):
		Global.player1.wea.NONE:
			texture = null
		Global.player1.wea.ODACHI:
			texture = img1
		Global.player1.wea.SHOTGUN:
			texture = img2
		
	pass
"

